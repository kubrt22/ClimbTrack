rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function pairId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function friendsList(data) {
      return data.friends is list ? data.friends : [];
    }

    function canAcceptForOtherUser(userId) {
      let requestId = pairId(request.auth.uid, userId);
      let oldFriends = friendsList(resource.data);
      return signedIn() &&
        request.auth.uid != userId &&
        exists(/databases/$(database)/documents/friend_requests/$(requestId)) &&
        get(/databases/$(database)/documents/friend_requests/$(requestId)).data.toUid == request.auth.uid &&
        get(/databases/$(database)/documents/friend_requests/$(requestId)).data.status == 'pending' &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['friends', 'updatedAt']) &&
        request.resource.data.friends is list &&
        request.resource.data.friends.hasAll(oldFriends) &&
        request.resource.data.friends.size() == oldFriends.size() + 1 &&
        request.auth.uid in request.resource.data.friends;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn();
      allow update: if signedIn() &&
        (request.auth.uid == userId || canAcceptForOtherUser(userId));
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /usernames/{usernameKey} {
      allow read: if true;

      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() > 0 &&
        request.resource.data.usernameLower == usernameKey &&
        !exists(/databases/$(database)/documents/usernames/$(usernameKey));

      allow update: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.usernameLower == usernameKey;

      allow delete: if false;
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn() &&
        (resource == null ||
         resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid);

      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected');

      allow delete: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
  }
}
